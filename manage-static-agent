def _wait_for_psc_attachment_disconnect(
    cfg: dict[str, Any], *, timeout_sec: int = 180, poll_interval_sec: int = 5
) -> None:
    """Wait until Vertex AI's tenant project detaches all PSC endpoints from the NetworkAttachment."""
    project_id = str(cfg["gcp"]["project_id"])
    region = str(cfg["gcp"].get("region", "us-east1"))
    prefix = str(cfg["networking"].get("resource_prefix", "hello-mcp-static"))
    attachment_name = f"{prefix}-psc-attachment"

    deadline = datetime.datetime.now(tz=datetime.UTC).timestamp() + timeout_sec
    attempt = 0
    while True:
        attempt += 1
        res = subprocess.run(
            [
                "gcloud",
                "compute",
                "network-attachments",
                "describe",
                attachment_name,
                f"--region={region}",
                f"--project={project_id}",
                "--format=json",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            # Network attachment already deleted or does not exist
            return
        try:
            data = json.loads(res.stdout) if res.stdout.strip() else {}
        except json.JSONDecodeError:
            return

        endpoints = data.get("connectionEndpoints") or []
        if not endpoints:
            if attempt > 1:
                print(f"    ✓ All PSC endpoints detached from '{attachment_name}'.")
            return

        now = datetime.datetime.now(tz=datetime.UTC).timestamp()
        if now >= deadline:
            print(
                f"    ! Warning: '{attachment_name}' still reports {len(endpoints)} connected "
                f"endpoint(s) after {timeout_sec}s; proceeding with Terraform destroy..."
            )
            return

        if attempt == 1:
            print(
                f"==> Waiting for Vertex AI tenant project to detach PSC endpoint(s) from '{attachment_name}'..."
            )
        print(
            f"    • {len(endpoints)} endpoint(s) still attached; re-checking in {poll_interval_sec}s..."
        )
        import time

        time.sleep(poll_interval_sec)


def cmd_undeploy(args: argparse.Namespace) -> None:
    config_path = Path(args.config).resolve()
    cfg = _load_config(config_path)
    tf_bin = _find_terraform_bin()

    # Ensure archive & tfvars exist so Terraform can evaluate variables during destroy
    if not ARCHIVE_PATH.exists():
        _package_agent_source(cfg)
    tfvars_path = _write_tfvars(cfg, ARCHIVE_PATH)
    _ensure_terraform_init(tf_bin)

    # Check if google_vertex_ai_reasoning_engine.app is in state; if so, destroy it
    # first so the Vertex AI tenant project begins detaching its PSC interface endpoint
    # before Terraform tries to delete google_compute_network_attachment.psc_attachment.
    state_res = subprocess.run(
        [tf_bin, f"-chdir={TERRAFORM_DIR}", "state", "list"],
        capture_output=True,
        text=True,
        check=False,
    )
    state_items = {
        line.strip() for line in state_res.stdout.splitlines() if line.strip()
    }
    if "google_vertex_ai_reasoning_engine.app" in state_items and not args.interactive:
        print("==> Step 1/2: Destroying Vertex AI Agent Engine runtime first...")
        subprocess.run(
            [
                tf_bin,
                f"-chdir={TERRAFORM_DIR}",
                "destroy",
                "-target=google_vertex_ai_reasoning_engine.app",
                f"-var-file={tfvars_path.name}",
                "-auto-approve",
            ],
            check=True,
        )

    # Wait for any PSC interface endpoints from the Vertex AI tenant project to finish detaching
    _wait_for_psc_attachment_disconnect(cfg)

    print("==> Destroying Static-IP GCP infrastructure via Terraform...")
    destroy_cmd = [
        tf_bin,
        f"-chdir={TERRAFORM_DIR}",
        "destroy",
        f"-var-file={tfvars_path.name}",
    ]
    if not args.interactive:
        destroy_cmd.append("-auto-approve")

    for attempt in range(1, 4):
        res = subprocess.run(destroy_cmd, check=False)
        if res.returncode == 0:
            break
        if attempt < 3 and not args.interactive:
            print(
                f"==> Terraform destroy encountered a transient dependency delay (attempt {attempt}/3); "
                "waiting for PSC endpoints to drain before retrying..."
            )
            _wait_for_psc_attachment_disconnect(cfg, timeout_sec=90)
        else:
            raise SystemExit(res.returncode)

    _update_deployment_metadata(None)
    print("==> Undeploy complete. All Agent Engine and static-IP networking resources removed.")


def _resolve_base_endpoint(cfg: dict[str, Any], tf_bin: str) -> str:
    outputs = _get_terraform_outputs(tf_bin)
    if outputs.get("agent_base_endpoint"):
        return str(outputs["agent_base_endpoint"])

    if METADATA_PATH.exists():
        try:
            meta = json.loads(METADATA_PATH.read_text(encoding="utf-8"))
            res_id = meta.get("remote_agent_runtime_id")
            if res_id and res_id != "None":
                region = cfg["gcp"].get("region", "us-east1")
                return f"https://{region}-aiplatform.googleapis.com/v1/{res_id}"
        except Exception:
            pass

    raise SystemExit(
        "Error: Agent is not deployed yet (no Terraform outputs or deployment_metadata.json found).\n"
        "Run './manage-static-agent deploy' first."
    )


def _create_remote_session(base_endpoint: str, headers: dict[str, str], user_id: str) -> str:
    query_url = f"{base_endpoint}:query"
    payload = {
        "class_method": "async_create_session",
        "input": {"user_id": user_id},
    }
    resp = requests.post(query_url, headers=headers, json=payload, timeout=60)
    if not resp.ok:
        raise SystemExit(
            f"Error creating session on Agent Engine (HTTP {resp.status_code}):\n{resp.text}"
        )
    data = resp.json()
    output = data.get("output", data)
    session_id = output.get("id") if isinstance(output, dict) else None
    if not session_id:
        raise SystemExit(f"Error: Unexpected session response from Agent Engine: {data}")
    return str(session_id)


def cmd_send(args: argparse.Namespace) -> None:
    config_path = Path(args.config).resolve()
    cfg = _load_config(config_path)
    tf_bin = _find_terraform_bin()

    prompt_parts = args.prompt or []
    prompt = " ".join(prompt_parts).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        raise SystemExit(
            "Error: Please provide a prompt, e.g.:\n"
            "  ./manage-static-agent send \"Greet Raul and check what IP the MCP server sees\""
        )

    base_endpoint = _resolve_base_endpoint(cfg, tf_bin)
    token = _get_access_token()
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }

    session_id = args.session_id or _create_remote_session(
        base_endpoint, headers, args.user_id
    )
    stream_url = f"{base_endpoint}:streamQuery"
    payload = {
        "class_method": "async_stream_query",
        "input": {
            "user_id": args.user_id,
            "session_id": session_id,
            "message": prompt,
        },
    }

    print(f"[user]: {prompt}")
    with requests.post(
        stream_url, headers=headers, json=payload, stream=True, timeout=180
    ) as resp:
        if not resp.ok:
            raise SystemExit(
                f"Error querying Agent Engine (HTTP {resp.status_code}):\n{resp.text}"
            )

        printed_text = False
        for line in resp.iter_lines(decode_unicode=True):
            if not line:
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue

            if args.verbose:
                print(f"\n[event]: {json.dumps(event, indent=2)}")

            content = event.get("content") or {}
            parts = content.get("parts") or []
            author = event.get("author", "agent")
            for part in parts:
                if "functionCall" in part:
                    fc = part["functionCall"]
                    print(f"[{author} -> tool_call]: {fc.get('name')}({json.dumps(fc.get('args', {}))})")
                elif "functionResponse" in part:
                    fr = part["functionResponse"]
                    print(f"[tool_response -> {author}]: {fr.get('name')} -> {json.dumps(fr.get('response', {}))}")
                elif "text" in part and part["text"]:
                    if not printed_text:
                        print(f"[{author}]: ", end="", flush=True)
                        printed_text = True
                    print(part["text"], end="", flush=True)

        if printed_text:
            print()
    print(f"[session_id]: {session_id}")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="manage-static-agent",
        description=(
            "Deploy, describe, query, and undeploy the ADK Agent on Vertex AI Agent Engine "
            "with a deterministic static outbound IP for remote MCP server calls."
        ),
    )
    parser.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )

    subparsers = parser.add_subparsers(dest="command", required=True)

    # preflight
    p_preflight = subparsers.add_parser(
        "preflight",
        help="Run preflight checks (caller permissions, enabled APIs, service agents, org policies) and remediate if needed",
    )
    p_preflight.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )
    p_preflight.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Automatically confirm applying any missing GCP project settings",
    )
    p_preflight.set_defaults(func=cmd_preflight)

    # deploy
    p_deploy = subparsers.add_parser(
        "deploy",
        help="Run preflight checks and fully deploy the agent and static-IP GCP services through Terraform",
    )
    p_deploy.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )
    p_deploy.add_argument(
        "--plan-only",
        "--dry-run",
        dest="plan_only",
        action="store_true",
        help="Package agent and run 'terraform plan' without applying changes",
    )
    p_deploy.add_argument(
        "-y",
        "--yes",
        action="store_true",
        help="Automatically confirm applying any missing GCP preflight settings",
    )
    p_deploy.add_argument(
        "--skip-preflight",
        action="store_true",
        help="Skip preflight permission/API/org-policy checks before running Terraform",
    )
    p_deploy.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="Prompt interactively for Terraform confirmation instead of -auto-approve",
    )
    p_deploy.set_defaults(func=cmd_deploy)

    # describe
    p_describe = subparsers.add_parser(
        "describe",
        help="Describe the deployment, static egress IP, agent endpoints, and GCP components",
    )
    p_describe.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )
    p_describe.add_argument(
        "--json",
        action="store_true",
        help="Output deployment description as JSON",
    )
    p_describe.set_defaults(func=cmd_describe)

    # undeploy
    p_undeploy = subparsers.add_parser(
        "undeploy",
        help="Undeploy and clean up the agent and all static-IP GCP resources via Terraform",
    )
    p_undeploy.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )
    p_undeploy.add_argument(
        "-i",
        "--interactive",
        action="store_true",
        help="Prompt interactively for Terraform destroy confirmation",
    )
    p_undeploy.set_defaults(func=cmd_undeploy)

    # send
    p_send = subparsers.add_parser(
        "send",
        help="Send a user prompt to the deployed agent and show the response",
    )
    p_send.add_argument(
        "prompt",
        nargs="*",
        help="User prompt to send to the agent",
    )
    p_send.add_argument(
        "-c",
        "--config",
        default=str(DEFAULT_CONFIG_PATH),
        help="Path to config.yaml (default: ./config.yaml)",
    )
    p_send.add_argument(
        "--session-id",
        default=None,
        help="Optional existing session ID to continue a conversation",
    )
    p_send.add_argument(
        "--user-id",
        default="cli-user",
        help="User ID for the session (default: cli-user)",
    )
    p_send.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Print raw streaming JSON events",
    )
    p_send.set_defaults(func=cmd_send)

    return parser


def main() -> None:
    parser = build_parser()
    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
