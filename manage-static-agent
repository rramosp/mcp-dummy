def cmd_deploy(args: argparse.Namespace) -> None:
    config_path = Path(args.config).resolve()
    cfg = _load_config(config_path)
    tf_bin = _find_terraform_bin()

    if not args.skip_preflight:
        run_preflight_checks(cfg, config_path=config_path, auto_confirm=args.yes)

    print(f"==> Loading configuration from {config_path}")
    print(f"    GCP Project:       {cfg['gcp']['project_id']}")
    print(f"    Region / Zone:     {cfg['gcp'].get('region', 'us-east1')} / {cfg['gcp'].get('zone', 'us-east1-b')}")
    print(f"    Agent Name:        {cfg['agent'].get('name', 'hello-mcp-agent')}")
    print(f"    Agent Model:       {cfg['agent'].get('model', 'gemini-2.5-flash')}")
    print(f"    Remote MCP Server: {cfg['mcp_server']['url']} ({cfg['mcp_server'].get('transport', 'streamable-http')})")

    print("==> Packaging ADK agent source archive...")
    archive_path = _package_agent_source(cfg)
    size_kb = archive_path.stat().st_size / 1024.0
    print(f"    Archive ready:     {archive_path} ({size_kb:.1f} KB)")

    tfvars_path = _write_tfvars(cfg, archive_path)
    print(f"    Terraform vars:    {tfvars_path}")

    _ensure_terraform_init(tf_bin)

    if args.plan_only:
        print("==> Running Terraform plan (--plan-only)...")
        subprocess.run(
            [
                tf_bin,
                f"-chdir={TERRAFORM_DIR}",
                "plan",
                f"-var-file={tfvars_path.name}",
            ],
            check=True,
        )
        return

    print("==> Applying Terraform deployment (Agent Engine + Static IP Egress Infrastructure)...")
    apply_cmd = [
        tf_bin,
        f"-chdir={TERRAFORM_DIR}",
        "apply",
        f"-var-file={tfvars_path.name}",
    ]
    if not args.interactive:
        apply_cmd.append("-auto-approve")

    subprocess.run(apply_cmd, check=True)

    outputs = _get_terraform_outputs(tf_bin)
    resource_name = outputs.get("agent_engine_resource_name")
    if resource_name:
        _update_deployment_metadata(resource_name)

    print("\n==> Deployment complete!")
    _print_description(cfg, outputs, as_json=False)


