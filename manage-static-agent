def _find_terraform_bin() -> str:
    """Locate a Terraform >= 1.0 binary."""
    candidates = [
        shutil.which("terraform"),
        str(Path.home() / ".terraform" / "bin" / "terraform"),
    ]
    for candidate in candidates:
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise SystemExit(
        "Error: 'terraform' binary not found on PATH or in ~/.terraform/bin/terraform."
    )


def _load_config(config_path: Path) -> dict[str, Any]:
    if not config_path.exists():
        raise SystemExit(f"Error: Configuration file not found: {config_path}")
    with open(config_path, "r", encoding="utf-8") as f:
        data = yaml.safe_load(f) or {}

    gcp = data.get("gcp") or {}
    agent = data.get("agent") or {}
    mcp_server = data.get("mcp_server") or {}
    networking = data.get("networking") or {}

    if not gcp.get("project_id"):
        raise SystemExit("Error: 'gcp.project_id' is required in config.yaml")
    if not mcp_server.get("url"):
        raise SystemExit("Error: 'mcp_server.url' is required in config.yaml")

    region = str(gcp.get("region", "us-east1")).strip()
    if region not in SUPPORTED_AGENT_ENGINE_REGIONS:
        supported_list = ", ".join(sorted(SUPPORTED_AGENT_ENGINE_REGIONS))
        raise SystemExit(
            f"Error: Unsupported gcp.region '{region}' for Vertex AI Agent Engine.\n"
            f"Supported regions ({len(SUPPORTED_AGENT_ENGINE_REGIONS)}): {supported_list}"
        )
    gcp["region"] = region

    # Every supported Agent Engine region has a '-b' zone (whereas us-east1 and
    # europe-west1 do not have '-a'). Default to '<region>-b' if omitted.
    zone = str(gcp.get("zone") or f"{region}-b").strip()
    valid_zones = [f"{region}-{z}" for z in SUPPORTED_AGENT_ENGINE_REGIONS[region]]
    if zone not in valid_zones:
        raise SystemExit(
            f"Error: Invalid gcp.zone '{zone}' for region '{region}'.\n"
            f"Valid zones in '{region}': {', '.join(valid_zones)}"
        )
    gcp["zone"] = zone

    dns_domain = str(networking.get("dns_peering_domain", "mcp.internal."))
    if not dns_domain.endswith("."):
        dns_domain += "."
    networking["dns_peering_domain"] = dns_domain

    return {
        "gcp": gcp,
        "agent": agent,
        "mcp_server": mcp_server,
        "networking": networking,
    }


def _get_access_token() -> str:
    try:
        creds, _ = google.auth.default(
            scopes=["https://www.googleapis.com/auth/cloud-platform"]
        )
        auth_req = google.auth.transport.requests.Request()
        creds.refresh(auth_req)
        if creds.token:
            return creds.token
    except Exception:
        pass

    res = subprocess.run(
        ["gcloud", "auth", "print-access-token"],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    raise SystemExit(
        "Error: Unable to obtain Google Cloud access token. "
        "Run 'gcloud auth application-default login' or 'gcloud auth login'."
    )


def _get_active_principal() -> str:
    res = subprocess.run(
        ["gcloud", "config", "get-value", "account"],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode == 0 and res.stdout.strip():
        return res.stdout.strip()
    return "<your-gcp-user-or-service-account-email>"


def _check_vertex_model_availability(
    project_id: str, model_name: str, location: str = "global"
) -> tuple[bool, str]:
    """Verify that `model_name` exists and is accessible in Vertex AI."""
    try:
        client = genai.Client(
            vertexai=True, project=project_id, location=location
        )
        info = client.models.get(model=model_name)
        client.models.count_tokens(model=model_name, contents="ping")
        resolved_name = getattr(info, "name", None) or f"publishers/google/models/{model_name}"
        return True, str(resolved_name)
    except Exception as exc:
        return False, str(exc)


def _discover_available_vertex_models(
    project_id: str, location: str = "global"
) -> list[str]:
    """Probe known Vertex AI Gemini models and return those available in `project_id`."""
    available: list[str] = []
    try:
        client = genai.Client(
            vertexai=True, project=project_id, location=location
        )
        for candidate in CANDIDATE_VERTEX_GEMINI_MODELS:
            try:
                client.models.get(model=candidate)
                available.append(candidate)
            except Exception:
                continue
    except Exception:
        pass
    return available


def _print_admin_request_and_exit(
    *,
    project_id: str,
    principal: str,
    missing_roles: list[str],
    missing_apis: list[str],
    missing_sa_bindings: list[tuple[str, str]],
    org_policy_notes: list[str],
    failure_detail: str | None = None,
) -> None:
    print("\n" + "!" * 78)
    print("  INSUFFICIENT PERMISSIONS TO UPDATE GCP PROJECT CONFIGURATION")
    print("!" * 78)
    if failure_detail:
        print(f"\n  Reason: {failure_detail}\n")

    member_type = (
        "serviceAccount"
        if principal.endswith(".gserviceaccount.com")
        else "user"
    )

    print("  Please send the following request to your GCP Project Administrator:\n")
    print("  " + "-" * 74)
    print(
        f"  Hello GCP Project Administrator,\n\n"
        f"  I am deploying a Vertex AI Agent Engine with a static outbound IP (via\n"
        f"  Private Service Connect Network Attachment, Egress Proxy VM, and Cloud NAT)\n"
        f"  in project '{project_id}', and my account ({principal}) lacks the\n"
        f"  permissions required to complete the project setup."
    )

    if missing_roles:
        roles_str = ", ".join(sorted(set(missing_roles)))
        print(
            f"\n  1. Please grant my principal ({member_type}:{principal}) the following\n"
            f"     IAM roles on project '{project_id}':\n"
            f"       {roles_str}\n"
        )
        for r in sorted(set(missing_roles)):
            print(
                f"     gcloud projects add-iam-policy-binding {project_id} \\\n"
                f"       --member=\"{member_type}:{principal}\" --role=\"{r}\""
            )

    if missing_apis:
        apis_str = " ".join(sorted(set(missing_apis)))
        print(
            f"\n  2. Please enable the following required Google Cloud APIs in '{project_id}':\n"
            f"     gcloud services enable {apis_str} --project={project_id}"
        )

    if missing_sa_bindings:
        print(
            f"\n  3. Please ensure the Vertex AI Service Agent and Compute Engine default\n"
            f"     service account exist and have the following project IAM bindings:"
        )
        print(
            f"     gcloud beta services identity create --service=aiplatform.googleapis.com --project={project_id}"
        )
        for member, role in missing_sa_bindings:
            print(
                f"     gcloud projects add-iam-policy-binding {project_id} \\\n"
                f"       --member=\"{member}\" --role=\"{role}\""
            )

    if org_policy_notes:
        print("\n  4. Organization Policy / Model Access adjustments required:")
        for note in org_policy_notes:
            print(f"     - {note}")

    print("  " + "-" * 74 + "\n")
    raise SystemExit(1)


def run_preflight_checks(
    cfg: dict[str, Any],
    *,
    config_path: Path = DEFAULT_CONFIG_PATH,
    auto_confirm: bool = False,
) -> None:
    """Inspect caller permissions, enabled APIs, service agents, org policies, and model availability.

    If any prerequisite is missing, inform the user, ask for confirmation, and
    attempt to remediate it. If the user lacks permissions to update the project,
    print a ready-to-send paragraph for the GCP Project Administrator and exit.
    """
    project_id = str(cfg["gcp"]["project_id"])
    region = str(cfg["gcp"]["region"])
    zone = str(cfg["gcp"]["zone"])
    agent_model = str(cfg["agent"].get("model", "gemini-2.5-flash")).strip()

    print("=" * 78)
    print(f"  PREFLIGHT CHECK — Project '{project_id}' ({region} / {zone})")
    print("=" * 78)

    token = _get_access_token()
    principal = _get_active_principal()
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }

    print(f"  [1/6] Active Principal: {principal}")

    # 1. CheckCaller IAM permissions via cloudresourcemanager testIamPermissions
    print("  [2/6] Checking caller IAM permissions on project...")
    test_perms_url = f"https://cloudresourcemanager.googleapis.com/v1/projects/{project_id}:testIamPermissions"
    all_required_perms = list(PERMISSION_TO_ROLE.keys())
    perm_resp = requests.post(
        test_perms_url,
        headers=headers,
        json={"permissions": all_required_perms},
        timeout=20,
    )
    if not perm_resp.ok:
        _print_admin_request_and_exit(
            project_id=project_id,
            principal=principal,
            missing_roles=sorted(set(PERMISSION_TO_ROLE.values())),
            missing_apis=REQUIRED_APIS,
            missing_sa_bindings=[],
            org_policy_notes=[],
            failure_detail=f"Cannot query project '{project_id}' permissions (HTTP {perm_resp.status_code}: {perm_resp.text}).",
        )

    granted_perms = set(perm_resp.json().get("permissions") or [])
    missing_perms = sorted(set(all_required_perms) - granted_perms)
    missing_caller_roles = sorted({PERMISSION_TO_ROLE[p] for p in missing_perms})
    can_set_iam = "resourcemanager.projects.setIamPolicy" in granted_perms
    can_enable_apis = "serviceusage.services.enable" in granted_perms

    if missing_perms and not can_set_iam:
        _print_admin_request_and_exit(
            project_id=project_id,
            principal=principal,
            missing_roles=missing_caller_roles,
            missing_apis=[],
            missing_sa_bindings=[],
            org_policy_notes=[],
            failure_detail=(
                f"Caller is missing required project permissions ({', '.join(missing_perms)}) "
                "and does not have 'resourcemanager.projects.setIamPolicy' to self-grant them."
            ),
        )
    elif not missing_perms:
        print("        ✓ Caller has all 21 required project IAM permissions.")
    else:
        print(f"        ! Caller is missing permissions: {', '.join(missing_perms)}")

    # Fetch project number
    proj_resp = requests.get(
        f"https://cloudresourcemanager.googleapis.com/v1/projects/{project_id}",
        headers=headers,
        timeout=20,
    )
    if not proj_resp.ok:
        _print_admin_request_and_exit(
            project_id=project_id,
            principal=principal,
            missing_roles=["roles/viewer"] + missing_caller_roles,
            missing_apis=["cloudresourcemanager.googleapis.com"],
            missing_sa_bindings=[],
            org_policy_notes=[],
            failure_detail=f"Unable to read project metadata for '{project_id}' (HTTP {proj_resp.status_code}).",
        )
    project_number = str(proj_resp.json().get("projectNumber", ""))

    # 2. Check Enabled APIs
    print("  [3/6] Checking required Google Cloud APIs...")
    enabled_apis: set[str] = set()
    svc_res = subprocess.run(
        [
            "gcloud",
            "services",
            "list",
            "--enabled",
            f"--project={project_id}",
            "--format=value(config.name)",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if svc_res.returncode == 0:
        enabled_apis = {line.strip() for line in svc_res.stdout.splitlines() if line.strip()}
    missing_apis = [api for api in REQUIRED_APIS if api not in enabled_apis]

    if not missing_apis:
        print(f"        ✓ All {len(REQUIRED_APIS)} required GCP APIs are enabled.")
    else:
        print(f"        ! Missing enabled APIs ({len(missing_apis)}): {', '.join(missing_apis)}")
        if not can_enable_apis:
            _print_admin_request_and_exit(
                project_id=project_id,
                principal=principal,
                missing_roles=["roles/serviceusage.serviceUsageAdmin"] + missing_caller_roles,
                missing_apis=missing_apis,
                missing_sa_bindings=[],
                org_policy_notes=[],
                failure_detail="Required GCP APIs are disabled and caller lacks 'serviceusage.services.enable'.",
            )

    # 3. Check Vertex AI Service Agent & Compute Default SA IAM bindings
    print("  [4/6] Checking Vertex AI Service Agent and project IAM bindings...")
    vertex_sa_email = f"service-{project_number}@gcp-sa-aiplatform.iam.gserviceaccount.com"
    vertex_sa_member = f"serviceAccount:{vertex_sa_email}"
    compute_sa_member = f"serviceAccount:{project_number}-compute@developer.gserviceaccount.com"

    required_sa_bindings = [
        (vertex_sa_member, "roles/compute.networkAdmin"),
        (vertex_sa_member, "roles/dns.peer"),
        (vertex_sa_member, "roles/aiplatform.user"),
        (compute_sa_member, "roles/cloudbuild.builds.builder"),
    ]
    missing_sa_bindings: list[tuple[str, str]] = []

    iam_resp = requests.post(
        f"https://cloudresourcemanager.googleapis.com/v1/projects/{project_id}:getIamPolicy",
        headers=headers,
        json={},
        timeout=20,
    )
    if iam_resp.ok:
        bindings = iam_resp.json().get("bindings") or []
        role_to_members: dict[str, set[str]] = {}
        for b in bindings:
            role_to_members.setdefault(b.get("role", ""), set()).update(b.get("members") or [])
        for member, role in required_sa_bindings:
            if member not in role_to_members.get(role, set()):
                missing_sa_bindings.append((member, role))

    if not missing_sa_bindings:
        print("        ✓ Vertex AI Service Agent and Compute SA IAM bindings are configured.")
    else:
        for member, role in missing_sa_bindings:
            print(f"        ! Missing IAM binding: {member} -> {role}")
        if not can_set_iam:
            _print_admin_request_and_exit(
                project_id=project_id,
                principal=principal,
                missing_roles=["roles/resourcemanager.projectIamAdmin"] + missing_caller_roles,
                missing_apis=missing_apis,
                missing_sa_bindings=missing_sa_bindings,
                org_policy_notes=[],
                failure_detail="Project service agent IAM bindings are missing and caller lacks 'resourcemanager.projects.setIamPolicy'.",
            )

    # 4. Check Organization Policy Constraints
    print("  [5/6] Checking effective Organization Policy constraints...")
    org_policy_notes: list[str] = []
    network_tf_path = TERRAFORM_DIR / "network.tf"
    need_disable_ip_forward_in_tf = False

    # Check compute.vmCanIpForward vs network.tf
    if network_tf_path.exists():
        net_tf_text = network_tf_path.read_text(encoding="utf-8")
        if "can_ip_forward            = true" in net_tf_text or "can_ip_forward = true" in net_tf_text:
            pol_res = subprocess.run(
                [
                    "gcloud",
                    "resource-manager",
                    "org-policies",
                    "describe",
                    "compute.vmCanIpForward",
                    f"--project={project_id}",
                    "--effective",
                    "--format=json",
                ],
                capture_output=True,
                text=True,
                check=False,
            )
            if pol_res.returncode == 0 and pol_res.stdout.strip():
                try:
                    pol_data = json.loads(pol_res.stdout)
                    if (pol_data.get("listPolicy") or {}).get("allValues") == "DENY":
                        need_disable_ip_forward_in_tf = True
                        print(
                            "        ! Org Policy 'constraints/compute.vmCanIpForward' is DENY, "
                            "and network.tf has can_ip_forward = true."
                        )
                except Exception:
                    pass

    # Check gcp.resourceLocations
    loc_res = subprocess.run(
        [
            "gcloud",
            "resource-manager",
            "org-policies",
            "describe",
            "gcp.resourceLocations",
            f"--project={project_id}",
            "--effective",
            "--format=json",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if loc_res.returncode == 0 and loc_res.stdout.strip():
        try:
            loc_data = json.loads(loc_res.stdout)
            list_pol = loc_data.get("listPolicy") or {}
            allowed_vals = list_pol.get("allowedValues") or []
            if allowed_vals and not any(
                region in v or f"in:{region}" in v or "in:us-locations" in v and region.startswith("us-")
                for v in allowed_vals
            ):
                org_policy_notes.append(
                    f"Constraint 'constraints/gcp.resourceLocations' restricts allowed regions to {allowed_vals}, "
                    f"which may block deployment in '{region}'."
                )
        except Exception:
            pass

    if org_policy_notes:
        _print_admin_request_and_exit(
            project_id=project_id,
            principal=principal,
            missing_roles=missing_caller_roles,
            missing_apis=missing_apis,
            missing_sa_bindings=missing_sa_bindings,
            org_policy_notes=org_policy_notes,
            failure_detail="An active Organization Policy constraint blocks deployment in the configured region.",
        )
    elif not need_disable_ip_forward_in_tf:
        print("        ✓ Organization Policy constraints verified (Shielded VM, no external VM IP, no IP forwarding required).")

    # 5. Check Vertex AI Gemini Model Availability
    print(f"  [6/6] Checking Vertex AI Gemini model availability ('{agent_model}' in 'global')...")
    replacement_model: str | None = None
    if "aiplatform.googleapis.com" in missing_apis:
        print("        ! Deferring model availability check until 'aiplatform.googleapis.com' is enabled.")
    else:
        model_ok, model_detail = _check_vertex_model_availability(
            project_id, agent_model, location="global"
        )
        if model_ok:
            print(
                f"        ✓ Model '{model_detail}' is available and accessible in Vertex AI ('global')."
            )
        else:
            available_models = _discover_available_vertex_models(
                project_id, location="global"
            )
            if available_models:
                replacement_model = available_models[0]
                print(
                    f"        ! Model '{agent_model}' is not available in Vertex AI ('global'): {model_detail.splitlines()[0][:140]}"
                )
                print(
                    f"        ! Available Vertex AI Gemini models in project '{project_id}': {', '.join(available_models)}"
                )
            elif "403" in model_detail or "PERMISSION_DENIED" in model_detail:
                if not can_set_iam:
                    _print_admin_request_and_exit(
                        project_id=project_id,
                        principal=principal,
                        missing_roles=["roles/aiplatform.user"] + missing_caller_roles,
                        missing_apis=missing_apis,
                        missing_sa_bindings=missing_sa_bindings,
                        org_policy_notes=[
                            f"Ensure Vertex AI Publisher Model access is enabled for Gemini models (e.g., 'gemini-2.5-flash') in project '{project_id}'."
                        ],
                        failure_detail=f"Permission denied accessing Vertex AI model '{agent_model}': {model_detail}",
                    )
                else:
                    if "roles/aiplatform.user" not in missing_caller_roles:
                        missing_caller_roles.append("roles/aiplatform.user")
            else:
                _print_admin_request_and_exit(
                    project_id=project_id,
                    principal=principal,
                    missing_roles=missing_caller_roles,
                    missing_apis=missing_apis,
                    missing_sa_bindings=missing_sa_bindings,
                    org_policy_notes=[
                        f"Publisher model '{agent_model}' (and standard Gemini 2.5/3 models) could not be accessed in project '{project_id}' (location 'global'). Please verify Vertex AI Model Garden access for Google Publisher models."
                    ],
                    failure_detail=f"Model '{agent_model}' is unavailable in project '{project_id}': {model_detail}",
                )

    # Check if any remediation is needed
    needs_remediation = bool(
        missing_caller_roles
        or missing_apis
        or missing_sa_bindings
        or need_disable_ip_forward_in_tf
        or replacement_model
    )

    if not needs_remediation:
        print("=" * 78)
        print("  ✓ All preflight checks passed! Ready to deploy.")
        print("=" * 78 + "\n")
        return

    print("\n" + "-" * 78)
    print("  MISSING CONFIGURATION DETECTED — REMEDIATION PLAN")
    print("-" * 78)
    if missing_caller_roles:
        print(f"  • Grant caller ({principal}) IAM roles: {', '.join(missing_caller_roles)}")
    if missing_apis:
        print(f"  • Enable GCP APIs: {', '.join(missing_apis)}")
    if missing_sa_bindings:
        print("  • Provision Vertex AI Service Agent identity (if not created yet) and grant IAM bindings:")
        for member, role in missing_sa_bindings:
            print(f"      - {member} -> {role}")
    if need_disable_ip_forward_in_tf:
        print(
            "  • Update terraform/network.tf to set 'can_ip_forward = false' on egress_proxy "
            "(complies with 'constraints/compute.vmCanIpForward' since our Layer-7 HTTP proxy does not require L3 IP forwarding)."
        )
    if replacement_model:
        print(
            f"  • Update 'agent.model' in {config_path.name} from '{agent_model}' to '{replacement_model}' "
            f"(verified available in Vertex AI for project '{project_id}')."
        )
    print("-" * 78)

    if not auto_confirm:
        if not sys.stdin.isatty():
            print(
                "\nNon-interactive shell detected. Re-run with '--yes' ('-y') to automatically "
                "apply these configuration updates, or run interactively to confirm."
            )
            raise SystemExit(1)
        answer = input(
            "\nWould you like manage-static-agent to apply these configuration updates now? [y/N]: "
        ).strip().lower()
        if answer not in ("y", "yes"):
            print("Aborted by user.")
            raise SystemExit(1)

    print("\n==> Applying required GCP project configuration updates...")
    member_type = (
        "serviceAccount"
        if principal.endswith(".gserviceaccount.com")
        else "user"
    )

    # 1. Self-grant missing caller roles if any
    for role in missing_caller_roles:
        print(f"    • Granting {role} to {member_type}:{principal}...")
        res = subprocess.run(
            [
                "gcloud",
                "projects",
                "add-iam-policy-binding",
                project_id,
                f"--member={member_type}:{principal}",
                f"--role={role}",
                "--quiet",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            _print_admin_request_and_exit(
                project_id=project_id,
                principal=principal,
                missing_roles=missing_caller_roles,
                missing_apis=missing_apis,
                missing_sa_bindings=missing_sa_bindings,
                org_policy_notes=org_policy_notes,
                failure_detail=f"Failed to grant role '{role}': {res.stderr.strip()}",
            )

    # 2. Enable missing APIs
    if missing_apis:
        print(f"    • Enabling GCP APIs: {', '.join(missing_apis)}...")
        res = subprocess.run(
            [
                "gcloud",
                "services",
                "enable",
                *missing_apis,
                f"--project={project_id}",
                "--quiet",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            _print_admin_request_and_exit(
                project_id=project_id,
                principal=principal,
                missing_roles=missing_caller_roles,
                missing_apis=missing_apis,
                missing_sa_bindings=missing_sa_bindings,
                org_policy_notes=org_policy_notes,
                failure_detail=f"Failed to enable required APIs: {res.stderr.strip()}",
            )

    # 3. Provision Vertex AI Service Agent and apply missing SA IAM bindings
    if missing_sa_bindings:
        print("    • Ensuring Vertex AI Service Agent identity exists...")
        subprocess.run(
            [
                "gcloud",
                "beta",
                "services",
                "identity",
                "create",
                "--service=aiplatform.googleapis.com",
                f"--project={project_id}",
                "--quiet",
            ],
            capture_output=True,
            text=True,
            check=False,
        )
        for member, role in missing_sa_bindings:
            print(f"    • Granting {role} to {member}...")
            res = subprocess.run(
                [
                    "gcloud",
                    "projects",
                    "add-iam-policy-binding",
                    project_id,
                    f"--member={member}",
                    f"--role={role}",
                    "--quiet",
                ],
                capture_output=True,
                text=True,
                check=False,
            )
            if res.returncode != 0:
                _print_admin_request_and_exit(
                    project_id=project_id,
                    principal=principal,
                    missing_roles=missing_caller_roles,
                    missing_apis=[],
                    missing_sa_bindings=missing_sa_bindings,
                    org_policy_notes=org_policy_notes,
                    failure_detail=f"Failed to bind '{role}' to '{member}': {res.stderr.strip()}",
                )

    # 4. Update can_ip_forward = false if needed
    if need_disable_ip_forward_in_tf and network_tf_path.exists():
        print("    • Updating terraform/network.tf to set can_ip_forward = false...")
        updated = (
            network_tf_path.read_text(encoding="utf-8")
            .replace("can_ip_forward            = true", "can_ip_forward            = false")
            .replace("can_ip_forward = true", "can_ip_forward = false")
        )
        network_tf_path.write_text(updated, encoding="utf-8")

    # 5. Update agent.model in config.yaml if replacement_model was selected
    if replacement_model:
        print(f"    • Updating 'agent.model' in {config_path} to '{replacement_model}'...")
        cfg["agent"]["model"] = replacement_model
        if config_path.exists():
            raw_cfg_text = config_path.read_text(encoding="utf-8")
            updated_cfg_text = raw_cfg_text.replace(
                f'model: "{agent_model}"', f'model: "{replacement_model}"'
            ).replace(
                f"model: '{agent_model}'", f"model: '{replacement_model}'"
            ).replace(
                f"model: {agent_model}", f'model: "{replacement_model}"'
            )
            config_path.write_text(updated_cfg_text, encoding="utf-8")

    # If aiplatform.googleapis.com was just enabled, verify model availability now
    if "aiplatform.googleapis.com" in missing_apis:
        current_model = str(cfg["agent"].get("model", "gemini-2.5-flash")).strip()
        model_ok, model_detail = _check_vertex_model_availability(
            project_id, current_model, location="global"
        )
        if not model_ok:
            available_models = _discover_available_vertex_models(project_id, location="global")
            if available_models:
                new_model = available_models[0]
                print(
                    f"    • Model '{current_model}' not found; updating 'agent.model' to available model '{new_model}'..."
                )
                cfg["agent"]["model"] = new_model
                if config_path.exists():
                    raw_cfg_text = config_path.read_text(encoding="utf-8")
                    config_path.write_text(
                        raw_cfg_text.replace(current_model, new_model),
                        encoding="utf-8",
                    )

    print("==> ✓ All required GCP project settings were successfully updated! Continuing...\n")


def _is_excluded_file(rel_posix: str, name: str) -> bool:
    for pat in _EXCLUDED_FILE_PATTERNS:
        if fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(rel_posix, pat):
            return True
    return False


def _packaged_files(root: Path) -> list[str]:
    files: list[str] = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir = Path(dirpath).relative_to(root)
        dirnames[:] = sorted(
            d
            for d in dirnames
            if d not in _EXCLUDED_DIRS
            and (rel_dir / d).as_posix() != "deployment/terraform"
        )
        for name in sorted(filenames):
            rel = (rel_dir / name).as_posix()
            if not _is_excluded_file(rel, name):
                files.append(rel)
    return sorted(files)


def _ensure_clean_uv_lock(agent_dir: Path) -> None:
    """Ensure uv.lock does not contain internal Google Airlock proxy URLs."""
    uv_lock = agent_dir / "uv.lock"
    if uv_lock.exists():
        content = uv_lock.read_text(encoding="utf-8", errors="ignore")
        if "airlock-proxy.uplink.goog" in content:
            print("Regenerating uv.lock with --no-config to remove internal proxy URLs...")
            uv_lock.unlink()
            subprocess.run(
                ["uv", "lock", "--no-config"],
                cwd=str(agent_dir),
                check=True,
            )


def _package_agent_source(cfg: dict[str, Any]) -> Path:
    """Create a deterministic .tar.gz archive of the agent source directory."""
    source_rel = cfg["agent"].get("source_dir", "./hello-mcp-agent")
    agent_dir = (SCRIPT_DIR / source_rel).resolve()
    if not agent_dir.exists():
        raise SystemExit(f"Error: Agent source directory not found: {agent_dir}")
    if not (agent_dir / "Dockerfile").exists():
        raise SystemExit(f"Error: Dockerfile not found in {agent_dir}")

    _ensure_clean_uv_lock(agent_dir)

    files = _packaged_files(agent_dir)
    if "Dockerfile" not in files:
        raise SystemExit("Error: Dockerfile is excluded by ignore rules.")

    BUILD_DIR.mkdir(parents=True, exist_ok=True)
    raw_buf = io.BytesIO()
    with gzip.GzipFile(filename="agent_source.tar", mode="wb", fileobj=raw_buf, mtime=0) as gz:
        with tarfile.open(fileobj=gz, mode="w", format=tarfile.PAX_FORMAT) as tar:
            for rel_path in files:
                full_path = agent_dir / rel_path
                arcname = f"./{rel_path}"
                info = tar.gettarinfo(str(full_path), arcname=arcname)
                info.mtime = 0
                info.uid = 0
                info.gid = 0
                info.uname = "root"
                info.gname = "root"
                if info.isfile():
                    with open(full_path, "rb") as rf:
                        tar.addfile(info, rf)
                else:
                    tar.addfile(info)

    ARCHIVE_PATH.write_bytes(raw_buf.getvalue())
    return ARCHIVE_PATH


