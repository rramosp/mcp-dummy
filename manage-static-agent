def _ensure_terraform_init(tf_bin: str) -> None:
    dot_tf = TERRAFORM_DIR / ".terraform"
    if not dot_tf.exists():
        print("==> Initializing Terraform...")
        subprocess.run(
            [tf_bin, f"-chdir={TERRAFORM_DIR}", "init"],
            check=True,
        )


def _get_terraform_outputs(tf_bin: str) -> dict[str, Any]:
    state_file = TERRAFORM_DIR / "terraform.tfstate"
    if not state_file.exists():
        return {}
    res = subprocess.run(
        [tf_bin, f"-chdir={TERRAFORM_DIR}", "output", "-json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if res.returncode != 0 or not res.stdout.strip():
        return {}
    try:
        raw = json.loads(res.stdout)
        return {k: v.get("value") for k, v in raw.items()}
    except json.JSONDecodeError:
        return {}


def _update_deployment_metadata(resource_name: str | None) -> None:
    if not METADATA_PATH.parent.exists():
        return
    if resource_name:
        payload = {
            "remote_agent_runtime_id": resource_name,
            "deployment_target": "agent_runtime",
            "is_a2a": True,
            "agent_directory": "app",
            "deployment_timestamp": datetime.datetime.now(tz=datetime.UTC).isoformat(),
        }
    else:
        payload = {
            "remote_agent_runtime_id": "None",
            "deployment_timestamp": "None",
        }
    METADATA_PATH.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")


def _fetch_live_engine_info(base_endpoint: str) -> dict[str, Any] | None:
    try:
        token = _get_access_token()
        resp = requests.get(
            base_endpoint,
            headers={"Authorization": f"Bearer {token}"},
            timeout=15,
        )
        if resp.ok:
            return resp.json()
    except Exception:
        pass
    return None


