def _try_get_access_token() -> str:
    """Attempt to obtain a gcloud access token without exiting on failure."""
    token = gcloud_value(["auth", "print-access-token"])
    if token:
        return token
    return gcloud_value(["auth", "application-default", "print-access-token"])


def _test_iam_permissions_batch(
    project_id: str, token: str, perms: list[str]
) -> tuple[set[str], set[str]]:
    """Test a list of IAM permissions via Cloud Resource Manager projects:testIamPermissions.

    If a batch contains a preview/v3 permission that the v1 projects:testIamPermissions
    endpoint rejects with HTTP 400, recursively bisects the batch so all supported
    permissions are still accurately evaluated and unsupported ones are returned in
    `untestable`.
    """
    if not perms:
        return set(), set()

    url = f"https://cloudresourcemanager.googleapis.com/v1/projects/{project_id}:testIamPermissions"
    headers = {
        "Authorization": f"Bearer {token}",
        "Content-Type": "application/json",
    }
    try:
        resp = requests.post(
            url, headers=headers, json={"permissions": perms}, timeout=20
        )
    except Exception:
        return set(), set(perms)

    if resp.status_code == 200:
        granted = set(resp.json().get("permissions", []))
        return granted, set()

    if resp.status_code == 400:
        # Check if the error message names a specific invalid permission
        try:
            err_msg = resp.json().get("error", {}).get("message", "")
        except Exception:
            err_msg = resp.text
        m = re.search(r"Permission ([a-zA-Z0-9_.]+) is not valid", err_msg)
        if m and m.group(1) in perms:
            bad_perm = m.group(1)
            remaining = [p for p in perms if p != bad_perm]
            granted, untestable = _test_iam_permissions_batch(
                project_id, token, remaining
            )
            untestable.add(bad_perm)
            return granted, untestable

        if len(perms) == 1:
            return set(), {perms[0]}
        mid = len(perms) // 2
        g1, u1 = _test_iam_permissions_batch(project_id, token, perms[:mid])
        g2, u2 = _test_iam_permissions_batch(project_id, token, perms[mid:])
        return g1 | g2, u1 | u2

    return set(), set(perms)


