            f"  {BOLD}Agent Gateway:{RESET}          {d['agw_name']} "
            f"(protocols={agw.get('protocols')}, serviceAccount={sa})"
        )
    else:
        warn(f"  Agent Gateway '{d['agw_name']}' not found in {region}.")

    header("Gemini Enterprise (geapp) & Custom MCP Connector Status")
    engine = resolve_geapp_engine(project_id, ge_location, cfg["geapp"]["name"])
    if engine:
        eng_id = engine.get("name", "").split("/")[-1]
        default_agw = (
            engine.get("agentGatewaySetting", {})
            .get("defaultEgressAgentGateway", {})
            .get("name", "None")
        )
        print(f"  {BOLD}Engine ID:{RESET}              {eng_id} (displayName='{engine.get('displayName')}')")
        print(f"  {BOLD}Default Egress Gateway:{RESET} {default_agw}")
        print(f"  {BOLD}Linked DataStores:{RESET}      {', '.join(engine.get('dataStoreIds', [])) or 'None'}")
    else:
        warn(f"  Gemini Enterprise Engine '{cfg['geapp']['name']}' not found.")

    dc = get_data_connector(project_id, ge_location, d["connector_id"])
