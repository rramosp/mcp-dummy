        }
        with open(agw_yaml_path, "w", encoding="utf-8") as f:
            yaml.safe_dump(agw_spec, f, sort_keys=False)

        run_cmd(
            [
                "gcloud",
                "alpha",
                "network-services",
                "agent-gateways",
                "import",
                d["agw_name"],
                f"--location={region}",
                f"--source={agw_yaml_path}",
                f"--project={project_id}",
                "--quiet",
            ]
        )

    agw_info = gcloud_json(
        [
            "alpha",
            "network-services",
            "agent-gateways",
            "describe",
            d["agw_name"],
            f"--location={region}",
        ],
        project_id,
    )
    if not agw_info:
        error(f"Failed to describe Agent Gateway '{d['agw_name']}' after import.")
        sys.exit(1)
    success(f"Agent Gateway '{d['agw_name']}' ready in {region}.")
    return agw_info


