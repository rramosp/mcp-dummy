# ─── Configuration Loader & Resource Naming ──────────────────────────────────
def load_config(config_path: str) -> dict[str, Any]:
    if not os.path.exists(config_path):
        error(f"Configuration file not found: {config_path}")
        sys.exit(1)
    with open(config_path, "r", encoding="utf-8") as f:
        cfg = yaml.safe_load(f)

    gcp = cfg.setdefault("gcp", {})
    mcp = cfg.setdefault("mcp_server", {})
    net = cfg.setdefault("networking", {})
    geapp = cfg.setdefault("geapp", {})

    if not gcp.get("project_id"):
        error("gcp.project_id is required in config.yaml")
        sys.exit(1)
    if not mcp.get("url"):
        error("mcp_server.url is required in config.yaml")
        sys.exit(1)
    if not geapp.get("name"):
        error("geapp.name is required in config.yaml")
        sys.exit(1)

    ge_location = geapp.setdefault("location", "global")
    expected_agw_region = GEAPP_LOCATION_TO_AGW_REGION.get(ge_location, "us-central1")
    agw_region = geapp.setdefault("gateway_region", expected_agw_region)

    prefix = net.setdefault("resource_prefix", "hello-mcp-static")
    # Use a distinct suffix `-agw` for Agent Gateway networking resources so
    # they never collide with `manage-static-agent` resources if both exist.
    agw_prefix = geapp.setdefault("resource_prefix", f"{prefix}-agw")
    net.setdefault("psc_subnet_cidr", "192.168.10.0/28")

    # Derive deterministic resource names (all <= 62 chars, lowercase RFC 1035).
    geapp.setdefault("connector_id", f"{agw_prefix}-conn")
    geapp.setdefault("connector_display_name", "Hello MCP Static (Agent Gateway)")
    geapp.setdefault("mcp_registry_name", f"{agw_prefix}-mcp")

    cfg["_derived"] = {
        "agw_prefix": agw_prefix,
        "agw_region": agw_region,
        "ge_location": ge_location,
        "vpc_name": f"{agw_prefix}-vpc",
        "psc_subnet_name": f"{agw_prefix}-psc-subnet",
        "router_name": f"{agw_prefix}-router",
        "nat_name": f"{agw_prefix}-nat",
        "nat_ip_name": f"{agw_prefix}-ip",
        "attachment_name": f"{agw_prefix}-psc-attachment",
        "act_name": f"{agw_prefix}-act",
        "agw_name": f"{agw_prefix}-gateway",
        "authz_ext_name": f"{agw_prefix}-iap-ext",
        "authz_policy_name": f"{agw_prefix}-authz-policy",
        "iap_policy_name": f"{agw_prefix}-iap-policy",
        "iap_binding_name": f"{agw_prefix}-iap-binding",
        "mcp_reg_name": geapp["mcp_registry_name"],
        "connector_id": geapp["connector_id"],
        "connector_display_name": geapp["connector_display_name"],
    }
    return cfg


# ─── Shell & gcloud Helpers ──────────────────────────────────────────────────
def run_cmd(
    cmd: list[str],
    *,
    capture: bool = False,
    check: bool = True,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess:
    merged_env = os.environ.copy()
    merged_env["CLOUDSDK_CORE_DISABLE_PROMPTS"] = "1"
    if env:
        merged_env.update(env)
    if not capture:
        info(f"Running: {' '.join(cmd)}")
    return subprocess.run(
        cmd,
        check=check,
        text=True,
        capture_output=capture,
        env=merged_env,
    )


def gcloud_json(args: list[str], project_id: str | None = None, check: bool = False) -> Any:
    cmd = ["gcloud"] + args + ["--format=json", "--quiet"]
    if project_id and not any(a.startswith("--project") for a in args):
        cmd.append(f"--project={project_id}")
    res = run_cmd(cmd, capture=True, check=check)
    if res.returncode != 0 or not res.stdout.strip():
        return None
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError:
        return None


def gcloud_value(args: list[str], project_id: str | None = None) -> str:
    cmd = ["gcloud"] + args + ["--quiet"]
    if project_id and not any(a.startswith("--project") for a in args):
        cmd.append(f"--project={project_id}")
    res = run_cmd(cmd, capture=True, check=False)
    if res.returncode != 0:
        return ""
    return res.stdout.strip()


def get_access_token() -> str:
    token = gcloud_value(["auth", "print-access-token"])
    if not token:
        error("Failed to obtain access token via `gcloud auth print-access-token`.")
        sys.exit(1)
    return token


def get_project_number(project_id: str) -> str:
    num = gcloud_value(
        ["projects", "describe", project_id, "--format=value(projectNumber)"]
    )
    if not num:
        error(f"Unable to resolve project number for project '{project_id}'.")
        sys.exit(1)
    return num


def get_org_id(project_id: str) -> str:
    res = run_cmd(
        [
            "gcloud",
            "projects",
            "get-ancestors",
            project_id,
            "--format=json",
            "--quiet",
        ],
        capture=True,
        check=False,
    )
    if res.returncode == 0 and res.stdout.strip():
        try:
            ancestors = json.loads(res.stdout)
            for item in ancestors:
                if item.get("type") == "organization":
                    return str(item.get("id", ""))
        except json.JSONDecodeError:
            pass
    return ""


# ─── Discovery Engine (Gemini Enterprise) REST Helpers ───────────────────────
def de_base_url(ge_location: str, api_version: str = "v1alpha") -> str:
    if ge_location in ("global", ""):
        host = "https://discoveryengine.googleapis.com"
    else:
        host = f"https://{ge_location}-discoveryengine.googleapis.com"
    return f"{host}/{api_version}"


def de_headers(project_id: str) -> dict[str, str]:
    return {
        "Authorization": f"Bearer {get_access_token()}",
        "Content-Type": "application/json",
        "X-Goog-User-Project": project_id,
    }


def resolve_geapp_engine(
    project_id: str, ge_location: str, geapp_name_or_id: str
) -> dict[str, Any] | None:
    """Resolve the Gemini Enterprise Engine by displayName, Engine ID, or full resource name."""
    headers = de_headers(project_id)
    base = de_base_url(ge_location, "v1alpha")
    target = geapp_name_or_id.strip()

    # 1. Try direct GET if target has no spaces (looks like an Engine ID or full resource name).
    if " " not in target:
        engine_id = target.split("/")[-1]
        direct_url = (
            f"{base}/projects/{project_id}/locations/{ge_location}"
            f"/collections/default_collection/engines/{engine_id}"
        )
        resp = requests.get(direct_url, headers=headers, timeout=30)
        if resp.status_code == 200:
            return resp.json()

    # 2. List all engines in default_collection and match by displayName, ID, or full name.
    list_url = (
        f"{base}/projects/{project_id}/locations/{ge_location}"
        f"/collections/default_collection/engines"
    )
    resp = requests.get(list_url, headers=headers, timeout=30)
    if resp.status_code == 200:
        engines = resp.json().get("engines", [])
        for eng in engines:
            eng_name = eng.get("name", "")
            eng_id = eng_name.split("/")[-1]
            disp = eng.get("displayName", "")
            if (
                target in (eng_id, eng_name, disp)
                or disp.lower() == target.lower()
            ):
                return eng
    return None



def get_data_connector(
    project_id: str, ge_location: str, collection_id: str
) -> dict[str, Any] | None:
    url = (
        f"{de_base_url(ge_location, 'v1alpha')}/projects/{project_id}"
        f"/locations/{ge_location}/collections/{collection_id}/dataConnector"
    )
    resp = requests.get(url, headers=de_headers(project_id), timeout=30)
    if resp.status_code == 200:
        return resp.json()
    return None


def poll_discovery_engine_lro(
    project_id: str, ge_location: str, op_name: str, timeout_sec: int = 300
) -> dict[str, Any]:
    """Poll a Discovery Engine long-running operation until completion."""
    base = de_base_url(ge_location, "v1alpha")
    url = f"{base}/{op_name}"
    deadline = time.time() + timeout_sec
    while time.time() < deadline:
        resp = requests.get(url, headers=de_headers(project_id), timeout=30)
        if resp.status_code != 200:
            raise RuntimeError(
                f"Failed polling LRO {op_name}: HTTP {resp.status_code} {resp.text}"
            )
        data = resp.json()
        if data.get("done"):
            if "error" in data:
                raise RuntimeError(
                    f"Operation {op_name} failed: {json.dumps(data['error'])}"
                )
            return data
        time.sleep(4)
    raise TimeoutError(f"Timed out waiting for Discovery Engine LRO: {op_name}")


# ─── Subcommand: preflight ───────────────────────────────────────────────────
def run_preflight(cfg: dict[str, Any]) -> bool:
    """Validate configuration, regional alignment, gcloud auth, APIs, and geapp."""
    gcp = cfg["gcp"]
    mcp = cfg["mcp_server"]
    net = cfg["networking"]
    geapp = cfg["geapp"]
    d = cfg["_derived"]

    project_id = gcp["project_id"]
    ge_location = d["ge_location"]
    agw_region = d["agw_region"]
    mcp_url = mcp["url"]

    header("Preflight Validation (Static IP via Agent Gateway + Gemini Enterprise)")
    passed = 0
    warned = 0
    failed = 0

    def ok(msg: str) -> None:
        nonlocal passed
        passed += 1
        success(msg)

    def warning(msg: str) -> None:
        nonlocal warned
        warned += 1
        warn(msg)

    def fail(msg: str) -> None:
        nonlocal failed
        failed += 1
        error(msg)

    # 1. Validate local CLI dependencies (`gcloud` only — no Terraform!)
    print(f"\n{BOLD}[1/6] Local CLI & Credentials{RESET}")
    if shutil.which("gcloud"):
        ok(f"gcloud CLI found: {shutil.which('gcloud')}")
    else:
        fail("gcloud CLI not found in PATH.")
        return False

    active_account = gcloud_value(["config", "get-value", "account"])
    if active_account:
        ok(f"gcloud active account: {active_account}")
    else:
        fail("No active gcloud account (`gcloud auth login` required).")

    project_number = get_project_number(project_id)
    org_id = get_org_id(project_id)
    ok(f"Target GCP Project: {project_id} (projectNumber={project_number}, orgId={org_id or 'N/A'})")

    # 2. Validate Regional Alignment & CIDR
    print(f"\n{BOLD}[2/6] Regional Alignment & Network Configuration{RESET}")
    expected_region = GEAPP_LOCATION_TO_AGW_REGION.get(ge_location)
    if not expected_region:
        fail(
            f"Unsupported geapp.location '{ge_location}'. Supported values: "
            f"{', '.join(GEAPP_LOCATION_TO_AGW_REGION)}"
        )
    elif agw_region != expected_region:
        fail(
            f"Regional mismatch: geapp.location='{ge_location}' requires "
            f"geapp.gateway_region='{expected_region}', got '{agw_region}'."
        )
    else:
        ok(
            f"Regional alignment verified: geapp.location='{ge_location}' <-> "
            f"Agent Gateway & Cloud NAT region='{agw_region}'"
        )

    parsed_mcp = urlparse(mcp_url)
    if parsed_mcp.scheme not in ("http", "https") or not parsed_mcp.hostname:
        fail(f"Invalid mcp_server.url '{mcp_url}' (must be http:// or https://).")
    elif parsed_mcp.query:
        fail(
            f"mcp_server.url '{mcp_url}' must not contain a query string when "
            "Agent Gateway egress is enabled."
        )
    else:
        ok(
            f"Remote MCP endpoint syntax valid: {mcp_url} "
            f"(host={parsed_mcp.hostname}, port={parsed_mcp.port or (443 if parsed_mcp.scheme == 'https' else 80)})"
        )
        if parsed_mcp.scheme != "https":
            warning(
                f"mcp_server.url '{mcp_url}' uses plain HTTP. Agent Gateway (Secure Web Proxy) "
                f"requires HTTPS with a publicly trusted TLS certificate on a domain name "
                f"(e.g., https://mcp.{parsed_mcp.hostname}.sslip.io/mcp) or requests will match "
                "'default_denied' (HTTP 404) at the gateway."
            )

    psc_cidr = net.get("psc_subnet_cidr", "192.168.10.0/28")
    try:
        prefix_len = int(psc_cidr.split("/")[1])
        if prefix_len <= 28:
            ok(f"PSC subnet CIDR '{psc_cidr}' (/<=28) is valid for Network Attachment.")
        else:
            fail(f"PSC subnet CIDR '{psc_cidr}' is too small (must be /28 or larger).")
    except (IndexError, ValueError):
        fail(f"Invalid PSC subnet CIDR '{psc_cidr}'.")

    # 3. Check Required GCP APIs
    print(f"\n{BOLD}[3/6] Required GCP Service APIs{RESET}")
    enabled_services_raw = gcloud_value(
        ["services", "list", "--enabled", "--format=value(config.name)"],
        project_id=project_id,
    )
    enabled_services = set(enabled_services_raw.splitlines())
    missing_apis = [api for api in REQUIRED_APIS if api not in enabled_services]
    if not missing_apis:
        ok(f"All {len(REQUIRED_APIS)} required GCP APIs are enabled.")
    else:
        warning(
            f"{len(missing_apis)} API(s) not yet enabled (will be enabled during `deploy`): "
            f"{', '.join(missing_apis)}"
        )

    # 4. Check Organization Policies
    print(f"\n{BOLD}[4/6] Organization Policy Constraints{RESET}")
    for constraint in (
        "iam.managed.disableAccessPolicyBinding",
        "discoveryengine.SkipCustomMcpRestriction",
        "discoveryengine.managed.disableCustomMcpServerConnector",
        "discoveryengine.managed.allowedEgressFqdns",
        "discoveryengine.managed.allowedDataSources",
    ):
        pol = gcloud_json(
            ["org-policies", "describe", constraint, "--effective"],
            project_id=project_id,
        )
        enforced = False
        if pol:
            for rule in pol.get("spec", {}).get("rules", []):
                if rule.get("enforce") is True:
                    enforced = True
        if not enforced:
            ok(f"Org policy '{constraint}' is not blocking.")
        else:
            warning(
                f"Org policy '{constraint}' is enforced (will be overridden during `deploy`)."
            )

    # 5. Check Gemini Enterprise App (`geapp`)
    print(f"\n{BOLD}[5/6] Gemini Enterprise App (geapp){RESET}")
    engine = resolve_geapp_engine(project_id, ge_location, geapp["name"])
    if engine:
        eng_id = engine.get("name", "").split("/")[-1]
        eng_display = engine.get("displayName", "")
        agw_setting = (
            engine.get("agentGatewaySetting", {})
            .get("defaultEgressAgentGateway", {})
            .get("name", "None")
        )
        ok(
            f"Found geapp Engine: '{eng_id}' (displayName='{eng_display}', "
            f"location='{ge_location}', defaultEgressAgentGateway='{agw_setting}')"
        )
    else:
        fail(
            f"Gemini Enterprise App '{geapp['name']}' not found in "
            f"projects/{project_id}/locations/{ge_location}/collections/default_collection/engines."
        )

    # 6. Check Existing Static IP / Agent Gateway State
    print(f"\n{BOLD}[6/6] Existing Agent Gateway & Static IP State{RESET}")
    addr = gcloud_json(
        ["compute", "addresses", "describe", d["nat_ip_name"], f"--region={agw_region}"],
        project_id=project_id,
    )
    if addr and addr.get("address"):
        ok(f"Reserved Static IP '{d['nat_ip_name']}' already exists: {addr['address']}")
    else:
        info(f"Reserved Static IP '{d['nat_ip_name']}' not yet created (will be created on `deploy`).")

    agw = gcloud_json(
        [
            "alpha",
            "network-services",
            "agent-gateways",
            "describe",
            d["agw_name"],
            f"--location={agw_region}",
        ],
        project_id=project_id,
    )
    if agw and agw.get("name"):
        ok(f"Agent Gateway '{d['agw_name']}' already exists in {agw_region}.")
    else:
        info(f"Agent Gateway '{d['agw_name']}' not yet created (will be created on `deploy`).")

    header("Preflight Summary")
    print(f"  {GREEN}{passed} passed{RESET}  |  {YELLOW}{warned} warnings{RESET}  |  {RED}{failed} failed{RESET}")
    if failed > 0:
        error("Preflight failed. Please resolve the errors above before running `deploy`.")
        return False
    success("Preflight passed!")
    return True


def cmd_preflight(cfg: dict[str, Any], _args: argparse.Namespace) -> None:
    if not run_preflight(cfg):
        sys.exit(1)


# ─── Subcommand: deploy ──────────────────────────────────────────────────────
def _ensure_apis_and_identities(project_id: str, project_number: str) -> None:
    header("Step 1/7: Enabling Required GCP APIs & Service Identities")
    run_cmd(["gcloud", "services", "enable"] + REQUIRED_APIS + [f"--project={project_id}", "--quiet"])

    for svc in SERVICE_IDENTITIES:
        run_cmd(
            [
                "gcloud",
                "beta",
                "services",
                "identity",
                "create",
                f"--service={svc}",
                f"--project={project_id}",
                "--quiet",
            ],
            check=False,
        )

    # Grant required roles to the Google-managed service agents
    bindings = [
        (
            f"serviceAccount:service-{project_number}@gcp-sa-discoveryengine.iam.gserviceaccount.com",
            "roles/discoveryengine.serviceAgent",
        ),
        (
            f"serviceAccount:service-{project_number}@gcp-sa-discoveryengine.iam.gserviceaccount.com",
            "roles/agentregistry.TempServiceAgent",
        ),
        (
            f"serviceAccount:service-{project_number}@gcp-sa-agentgateway.iam.gserviceaccount.com",
            "roles/agentgateway.serviceAgent",
        ),
        (
            f"serviceAccount:service-{project_number}@gcp-sa-networkservices.iam.gserviceaccount.com",
            "roles/networkservices.serviceAgent",
        ),
        (
            f"serviceAccount:service-{project_number}@gcp-sa-iap.iam.gserviceaccount.com",
            "roles/iap.egressServiceAgent",
        ),
    ]
    for member, role in bindings:
        run_cmd(
            [
                "gcloud",
                "projects",
                "add-iam-policy-binding",
                project_id,
                f"--member={member}",
                f"--role={role}",
                "--condition=None",
                "--quiet",
            ],
            capture=True,
            check=False,
        )
    success("APIs and Google-managed service agents configured.")


def _ensure_org_policies(project_id: str) -> None:
    header("Step 2/7: Ensuring Organization Policy Overrides for Custom MCP & IAM v3")
    with tempfile.TemporaryDirectory() as tmpdir:
        for constraint in (
            "iam.managed.disableAccessPolicyBinding",
            "discoveryengine.SkipCustomMcpRestriction",
            "discoveryengine.managed.disableCustomMcpServerConnector",
            "discoveryengine.managed.allowedEgressFqdns",
            "discoveryengine.managed.allowedDataSources",
        ):
            pol_path = os.path.join(tmpdir, f"{constraint}.yaml")
            with open(pol_path, "w", encoding="utf-8") as f:
                yaml.safe_dump(
                    {
                        "name": f"projects/{project_id}/policies/{constraint}",
                        "spec": {"rules": [{"enforce": False}]},
                    },
                    f,
                )
            res = run_cmd(
                [
                    "gcloud",
                    "org-policies",
                    "set-policy",
                    pol_path,
                    f"--project={project_id}",
                    "--quiet",
                ],
                capture=True,
                check=False,
            )
            if res.returncode == 0:
                success(f"Org policy '{constraint}' set to enforce: false.")
            else:
                warn(
                    f"Could not set org policy '{constraint}' (may already be false or lack orgpolicy.policyAdmin)."
                )


def _ensure_vpc_nat_psc(cfg: dict[str, Any]) -> str:
    header("Step 3/7: Provisioning VPC, PSC Subnet, Cloud Router, Cloud NAT & Static IP")
    project_id = cfg["gcp"]["project_id"]
    psc_cidr = cfg["networking"]["psc_subnet_cidr"]
    d = cfg["_derived"]
    region = d["agw_region"]

    # 1. VPC Network
    if not gcloud_json(["compute", "networks", "describe", d["vpc_name"]], project_id):
        run_cmd(
            [
                "gcloud",
                "compute",
                "networks",
                "create",
                d["vpc_name"],
                "--subnet-mode=custom",
                f"--project={project_id}",
                "--quiet",
            ]
        )
    else:
        info(f"VPC '{d['vpc_name']}' already exists.")

    # 2. PSC Subnet (with Private Google Access enabled)
    if not gcloud_json(
        ["compute", "networks", "subnets", "describe", d["psc_subnet_name"], f"--region={region}"],
        project_id,
    ):
        run_cmd(
            [
                "gcloud",
                "compute",
                "networks",
                "subnets",
                "create",
                d["psc_subnet_name"],
                f"--network={d['vpc_name']}",
                f"--region={region}",
                f"--range={psc_cidr}",
                "--enable-private-ip-google-access",
                f"--project={project_id}",
                "--quiet",
            ]
        )
    else:
        info(f"PSC Subnet '{d['psc_subnet_name']}' already exists.")

    # 3. Reserved Static External IP for Cloud NAT
    addr = gcloud_json(
        ["compute", "addresses", "describe", d["nat_ip_name"], f"--region={region}"],
        project_id,
    )
    if not addr:
        run_cmd(
            [
                "gcloud",
                "compute",
                "addresses",
                "create",
                d["nat_ip_name"],
                f"--region={region}",
                f"--project={project_id}",
                "--quiet",
            ]
        )
        addr = gcloud_json(
            ["compute", "addresses", "describe", d["nat_ip_name"], f"--region={region}"],
            project_id,
        )
    static_ip = (addr or {}).get("address", "")
    if not static_ip:
        error(f"Failed to resolve Static External IP address for '{d['nat_ip_name']}'.")
        sys.exit(1)
    success(f"Reserved Static Outbound IP ({d['nat_ip_name']}): {BOLD}{static_ip}{RESET}")

    # 4. Cloud Router
    if not gcloud_json(
        ["compute", "routers", "describe", d["router_name"], f"--region={region}"],
        project_id,
    ):
        run_cmd(
            [
                "gcloud",
                "compute",
                "routers",
                "create",
                d["router_name"],
                f"--network={d['vpc_name']}",
                f"--region={region}",
                f"--project={project_id}",
                "--quiet",
            ]
        )
    else:
        info(f"Cloud Router '{d['router_name']}' already exists.")

    # 5. Cloud NAT pinned to the Reserved Static External IP
    nat_info = gcloud_json(
        [
            "compute",
            "routers",
            "nats",
            "describe",
            d["nat_name"],
            f"--router={d['router_name']}",
            f"--region={region}",
        ],
        project_id,
    )
    if not nat_info:
        run_cmd(
            [
                "gcloud",
                "compute",
                "routers",
                "nats",
                "create",
                d["nat_name"],
                f"--router={d['router_name']}",
                f"--region={region}",
                "--nat-all-subnet-ip-ranges",
                f"--nat-external-ip-pool={d['nat_ip_name']}",
                "--enable-logging",
                f"--project={project_id}",
                "--quiet",
            ]
        )
    else:
        info(f"Cloud NAT '{d['nat_name']}' already exists.")

    # 6. PSC Network Attachment (ACCEPT_AUTOMATIC)
    na_info = gcloud_json(
        [
            "compute",
            "network-attachments",
            "describe",
            d["attachment_name"],
            f"--region={region}",
        ],
        project_id,
    )
    if not na_info:
        run_cmd(
            [
                "gcloud",
                "compute",
                "network-attachments",
                "create",
                d["attachment_name"],
                f"--region={region}",
                f"--subnets={d['psc_subnet_name']}",
                "--connection-preference=ACCEPT_AUTOMATIC",
                f"--project={project_id}",
                "--quiet",
            ]
        )
    else:
        info(f"PSC Network Attachment '{d['attachment_name']}' already exists.")

    success(
        f"Networking ready in {region}: PSC Attachment '{d['attachment_name']}' -> "
        f"Cloud NAT '{d['nat_name']}' -> Static IP {static_ip}"
    )
    return static_ip


def _ensure_agent_gateway_and_act(
    cfg: dict[str, Any], project_number: str
) -> dict[str, Any]:
    header("Step 4/7: Provisioning AgentConnectivityTemplate (ALL_TRAFFIC) & Agent Gateway")
    project_id = cfg["gcp"]["project_id"]
    d = cfg["_derived"]
    region = d["agw_region"]

    act_full_name = (
        f"projects/{project_number}/locations/{region}"
        f"/agentConnectivityTemplates/{d['act_name']}"
    )
    na_full_name = (
        f"projects/{project_id}/regions/{region}"
        f"/networkAttachments/{d['attachment_name']}"
    )

    with tempfile.TemporaryDirectory() as tmpdir:
        # 1. AgentConnectivityTemplate with vpcEgress: ALL_TRAFFIC
        act_yaml_path = os.path.join(tmpdir, "act.yaml")
        act_spec = {
            "accessPath": "AGENT_TO_ANYWHERE",
            "name": act_full_name,
            "deploymentModel": "CENTRALIZED",
            "egressNetworkConfig": {
                "networkAttachment": na_full_name,
                "vpcEgress": "ALL_TRAFFIC",
            },
        }
        with open(act_yaml_path, "w", encoding="utf-8") as f:
            yaml.safe_dump(act_spec, f, sort_keys=False)

        run_cmd(
            [
                "gcloud",
                "alpha",
                "network-services",
                "agent-connectivity-templates",
                "import",
                d["act_name"],
                f"--location={region}",
                f"--source={act_yaml_path}",
                f"--project={project_id}",
                "--quiet",
            ]
        )
        success(f"AgentConnectivityTemplate '{d['act_name']}' imported (vpcEgress=ALL_TRAFFIC).")

        # 2. AgentGateway referencing the AgentConnectivityTemplate and Agent Registry
        agw_yaml_path = os.path.join(tmpdir, "agw.yaml")
        agw_spec = {
            "name": d["agw_name"],
            "protocols": ["MCP"],
            "googleManaged": {
                "governedAccessPath": "AGENT_TO_ANYWHERE",
            },
            "agentConnectivityTemplate": act_full_name,
            "registries": [
                f"//agentregistry.googleapis.com/projects/{project_id}/locations/{region}"
