def _ensure_agent_registry_and_iam_v3(
    cfg: dict[str, Any], project_number: str, org_id: str, engine_id: str
) -> str:
    header("Step 6/7: Registering MCP Server in Agent Registry & Configuring IAM v3 Access Policy")
    project_id = cfg["gcp"]["project_id"]
    mcp_url = cfg["mcp_server"]["url"]
    d = cfg["_derived"]
    region = d["agw_region"]
    ge_location = d["ge_location"]

    # 1. Register MCP server in Agent Registry
    existing_svc = gcloud_json(
        [
            "agent-registry",
            "services",
            "describe",
            d["mcp_reg_name"],
            f"--location={region}",
        ],
        project_id,
    )
    with tempfile.TemporaryDirectory() as tmpdir:
        toolspec_path = os.path.join(tmpdir, "toolspec.json")
        with open(toolspec_path, "w", encoding="utf-8") as f:
            json.dump(DEFAULT_MCP_TOOLS_SPEC, f, indent=2)

        if not existing_svc:
            run_cmd(
                [
                    "gcloud",
                    "agent-registry",
                    "services",
                    "create",
                    d["mcp_reg_name"],
                    f"--location={region}",
                    f"--display-name={d['connector_display_name']}",
                    "--description=Remote Hello World MCP server accessed via Agent Gateway static IP",
                    f"--interfaces=protocolBinding=JSONRPC,url={mcp_url}",
                    "--mcp-server-spec-type=tool-spec",
                    f"--mcp-server-spec-content={toolspec_path}",
                    f"--project={project_id}",
                    "--quiet",
                ]
            )
        else:
            info(f"Updating existing Agent Registry service '{d['mcp_reg_name']}' with url={mcp_url}...")
            run_cmd(
                [
                    "gcloud",
                    "agent-registry",
                    "services",
                    "update",
                    d["mcp_reg_name"],
                    f"--location={region}",
                    f"--display-name={d['connector_display_name']}",
                    "--description=Remote Hello World MCP server accessed via Agent Gateway static IP",
                    f"--interfaces=protocolBinding=JSONRPC,url={mcp_url}",
                    f"--mcp-server-spec-content={toolspec_path}",
                    f"--project={project_id}",
                    "--quiet",
                ]
            )

    # Wait briefly for Agent Registry to materialize the projected McpServer resource
    mcp_server_resource_name = (
        f"projects/{project_id}/locations/{region}/mcpServers/{d['mcp_reg_name']}"
    )
    mcp_server_uid = ""
    for _ in range(10):
        servers = gcloud_json(
            ["agent-registry", "mcp-servers", "list", f"--location={region}"],
            project_id,
        )
        if isinstance(servers, list):
            for srv in servers:
                name = srv.get("name", "")
                if (
                    d["mcp_reg_name"] in name
                    or srv.get("displayName") == d["connector_display_name"]
                ):
                    mcp_server_resource_name = name
                    mcp_server_uid = srv.get("mcpServerId", "") or name.split("/")[-1]
                    break
        if mcp_server_uid:
            break
        time.sleep(2)

    success(
        f"Agent Registry MCP Server ready: {mcp_server_resource_name} "
        f"(mcpServerId={mcp_server_uid or 'pending'})"
    )

    # 2. Create IAM v3 AccessPolicy & PolicyBinding (IAP V2 Unified Access Policy)
    #    authorizing the geapp's default_assistant SPIFFE identities.
    if not org_id:
        error(
            f"Could not determine Organization ID for project '{project_id}', "
            "which is required to construct the SPIFFE principal for IAM v3 AccessPolicy."
        )
        sys.exit(1)

    principals = [
        (
            f"principal://agents.global.org-{org_id}.system.id.goog/resources/discoveryengine"
            f"/projects/{project_number}/locations/{ge_location}/engines/{engine_id}"
            f"/assistants/default_assistant/agents/default/core_assistant"
        ),
        (
            f"principal://agents.global.org-{org_id}.system.id.goog/resources/aiplatform"
            f"/projects/{project_number}/locations/{ge_location}/collections/default_collection"
            f"/engines/{engine_id}/assistants/default_assistant"
        ),
    ]

    existing_ap = gcloud_json(
        [
            "iam",
            "access-policies",
            "describe",
            d["iap_policy_name"],
            "--location=global",
        ],
        project_id,
    )
    if not existing_ap:
        with tempfile.TemporaryDirectory() as tmpdir:
            rules_path = os.path.join(tmpdir, "iap_rules.json")
            rule_payload = [
                {
                    "description": f"allow geapp {engine_id} assistant to any registered service",
                    "effect": "ALLOW",
                    "principals": principals,
                    "operation": {
                        "permissions": [
                            "iap.googleapis.com/resources.egressViaIAP",
                        ],
                    },
                    "conditions": {
                        "iap.googleapis.com": {
                            "expression": "destination.is_registered == true",
                        }
                    },
                }
            ]
            with open(rules_path, "w", encoding="utf-8") as f:
                json.dump(rule_payload, f, indent=2)

            run_cmd(
                [
                    "gcloud",
                    "iam",
                    "access-policies",
                    "create",
                    d["iap_policy_name"],
                    "--location=global",
                    f"--display-name={d['iap_policy_name']}",
                    f"--details-rules={rules_path}",
                    f"--project={project_id}",
                    "--quiet",
                ]
            )
        success(f"IAM v3 AccessPolicy '{d['iap_policy_name']}' created.")
    else:
        info(f"IAM v3 AccessPolicy '{d['iap_policy_name']}' already exists.")

    existing_pb = gcloud_json(
        [
            "iam",
            "policy-bindings",
            "describe",
            d["iap_binding_name"],
            "--location=global",
        ],
        project_id,
    )
    if not existing_pb:
        target_resource = f"//cloudresourcemanager.googleapis.com/projects/{project_id}"
        policy_ref = f"projects/{project_id}/locations/global/accessPolicies/{d['iap_policy_name']}"
        run_cmd(
            [
                "gcloud",
                "iam",
                "policy-bindings",
                "create",
                d["iap_binding_name"],
                "--location=global",
                f"--policy={policy_ref}",
                f"--target-resource={target_resource}",
                f"--project={project_id}",
                "--quiet",
            ]
        )
        success(f"IAM v3 PolicyBinding '{d['iap_binding_name']}' bound to {target_resource}.")
    else:
        info(f"IAM v3 PolicyBinding '{d['iap_binding_name']}' already exists.")

    return mcp_server_resource_name


def _ensure_geapp_and_mcp_connector(
    cfg: dict[str, Any],
    project_number: str,
    engine: dict[str, Any],
    mcp_server_resource_name: str,
) -> dict[str, Any]:
    header("Step 7/7: Wiring Agent Gateway & Custom MCP Connector into Gemini Enterprise (geapp)")
    project_id = cfg["gcp"]["project_id"]
    mcp_url = cfg["mcp_server"]["url"]
    d = cfg["_derived"]
    ge_location = d["ge_location"]
    agw_region = d["agw_region"]
    collection_id = d["connector_id"]
    engine_id = engine["name"].split("/")[-1]

    headers = de_headers(project_id)
    v1_base = de_base_url(ge_location, "v1")
    v1alpha_base = de_base_url(ge_location, "v1alpha")

    # 1. Patch the geapp Engine's `agentGatewaySetting.defaultEgressAgentGateway.name`
    agw_resource = f"projects/{project_id}/locations/{agw_region}/agentGateways/{d['agw_name']}"
    engine_patch_url = (
        f"{v1_base}/projects/{project_id}/locations/{ge_location}"
        f"/collections/default_collection/engines/{engine_id}"
        "?updateMask=agentGatewaySetting.defaultEgressAgentGateway.name"
    )
    patch_body = {
        "agentGatewaySetting": {
            "defaultEgressAgentGateway": {
                "name": agw_resource,
            }
        }
    }
    resp = requests.patch(engine_patch_url, headers=headers, json=patch_body, timeout=30)
    if resp.status_code != 200:
        error(
            f"Failed patching defaultEgressAgentGateway on Engine '{engine_id}': "
            f"HTTP {resp.status_code} {resp.text}"
        )
        sys.exit(1)
    success(f"Bound Agent Gateway '{agw_resource}' to geapp Engine '{engine_id}'.")

    # 2. Create and activate the Custom MCP DataConnector in Gemini Enterprise
    existing_dc = get_data_connector(project_id, ge_location, collection_id)
    agw_engine_resource = (
        f"projects/{project_id}/locations/{ge_location}"
        f"/collections/default_collection/engines/{engine_id}"
    )
    action_params = {
        "auth_type": "NO_AUTH",
        "instance_uri": mcp_url,
        "mcp_server_source": "REGISTRY_MCP",
        "registry_mcp_server_name": mcp_server_resource_name,
        "mcp_agent_instructions": (
            "MANDATORY HELLO MCP AGENT: Always invoke the hello or hello_from_ip "
            "tool whenever the user asks to greet someone, say hello, or check "
            "what incoming IP address or headers the MCP server sees."
        ),
        "use_agent_gateway_egress": True,
        "agent_gateway_engine": agw_engine_resource,
    }

    if not existing_dc:
        setup_url = (
            f"{v1alpha_base}/projects/{project_id}/locations/{ge_location}"
            ":setUpDataConnector"
        )
        setup_payload = {
            "collectionId": collection_id,
            "collectionDisplayName": d["connector_display_name"],
            "dataConnector": {
                "dataSource": "custom_mcp",
                "dataSourceVersion": 1,
                "params": {
                    "oauth_access_token": "unused",
                },
                "refreshInterval": "86400s",
                "entities": [
                    {
                        "entityName": "mcp_data",
                    }
                ],
                "connectorModes": [
                    "FEDERATED",
                ],
                "actionConfig": {
                    "isActionConfigured": True,
                    "createBapConnection": True,
                    "actionParams": dict(action_params),
                },
            },
        }
        info(f"Creating Custom MCP DataConnector in collection '{collection_id}'...")
        setup_resp = requests.post(setup_url, headers=headers, json=setup_payload, timeout=60)
        if setup_resp.status_code != 200:
            error(
                f"Failed calling setUpDataConnector for '{collection_id}': "
                f"HTTP {setup_resp.status_code} {setup_resp.text}"
            )
            sys.exit(1)
        op_data = setup_resp.json()
        op_name = op_data.get("name", "")
        if op_name and not op_data.get("done"):
            info(f"Waiting for DataConnector provisioning LRO ({op_name})...")
            poll_discovery_engine_lro(project_id, ge_location, op_name)
        success(f"Custom MCP DataConnector '{collection_id}' created.")
    else:
        info(f"Custom MCP DataConnector '{collection_id}' already exists.")

    # Activate the DataConnector actionConfig & bind to the Agent Gateway Engine
    activate_url = (
        f"{v1alpha_base}/projects/{project_id}/locations/{ge_location}"
        f"/collections/{collection_id}/dataConnector?updateMask=actionConfig"
    )
    activate_payload = {
        "name": f"projects/{project_id}/locations/{ge_location}/collections/{collection_id}/dataConnector",
        "actionConfig": {
            "isActionConfigured": True,
            "createBapConnection": True,
            "actionParams": dict(action_params),
        },
    }
    info(f"Activating Custom MCP DataConnector '{collection_id}' and linking to Engine '{engine_id}'...")
    act_resp = requests.patch(activate_url, headers=headers, json=activate_payload, timeout=60)
    if act_resp.status_code != 200:
        error(
            f"Failed activating DataConnector '{collection_id}': "
            f"HTTP {act_resp.status_code} {act_resp.text}"
        )
        sys.exit(1)
    existing_dc = get_data_connector(project_id, ge_location, collection_id)
    success(
        f"Activated Custom MCP DataConnector '{collection_id}' "
        f"(state={(existing_dc or {}).get('state')}, actionState={(existing_dc or {}).get('actionState')})."
    )

    # 3. Ensure `${collection_id}_mcp_data` is attached to the geapp Engine's `dataStoreIds`
    #    and detach any legacy non-Agent-Gateway MCP dataStore pointing to the same MCP URL
    #    so prompts issued from geapp always route through the Agent Gateway static IP.
    latest_engine = resolve_geapp_engine(project_id, ge_location, engine_id) or engine
    current_ds_ids = list(latest_engine.get("dataStoreIds", []))
    mcp_ds_id = f"{collection_id}_mcp_data"
    cleaned_ds_ids: list[str] = []
    removed_legacy: list[str] = []
    for ds_id in current_ds_ids:
        if ds_id != mcp_ds_id and ds_id.endswith("_mcp_data"):
            other_coll = ds_id[: -len("_mcp_data")]
            other_dc = get_data_connector(project_id, ge_location, other_coll)
            other_uri = (
                (other_dc or {}).get("actionConfig", {}).get("actionParams", {}).get("instance_uri")
                or (other_dc or {}).get("params", {}).get("instance_uri")
            )
            if other_uri == mcp_url:
                removed_legacy.append(ds_id)
                continue
        cleaned_ds_ids.append(ds_id)

    if mcp_ds_id not in cleaned_ds_ids:
        cleaned_ds_ids.append(mcp_ds_id)

    if cleaned_ds_ids != current_ds_ids:
        ds_patch_url = (
            f"{v1alpha_base}/projects/{project_number}/locations/{ge_location}"
            f"/collections/default_collection/engines/{engine_id}"
            "?updateMask=dataStoreIds"
        )
        ds_resp = requests.patch(
            ds_patch_url,
            headers=headers,
            json={"dataStoreIds": cleaned_ds_ids},
            timeout=30,
        )
        if ds_resp.status_code != 200:
            error(
                f"Failed updating dataStoreIds on Engine '{engine_id}': "
                f"HTTP {ds_resp.status_code} {ds_resp.text}"
            )
            sys.exit(1)
        if removed_legacy:
            info(
                f"Detached non-AGW MCP DataStore(s) targeting {mcp_url}: "
                f"{', '.join(removed_legacy)}"
            )
        success(f"Attached MCP DataStore '{mcp_ds_id}' to geapp Engine '{engine_id}'.")
    else:
        info(f"MCP DataStore '{mcp_ds_id}' is attached to geapp Engine '{engine_id}'.")

    return existing_dc or {}


def cmd_deploy(cfg: dict[str, Any], _args: argparse.Namespace) -> None:
    if not run_preflight(cfg):
        sys.exit(1)

    project_id = cfg["gcp"]["project_id"]
    ge_location = cfg["_derived"]["ge_location"]
    geapp_name = cfg["geapp"]["name"]

    project_number = get_project_number(project_id)
    org_id = get_org_id(project_id)
    engine = resolve_geapp_engine(project_id, ge_location, geapp_name)
    if not engine:
        error(f"Could not resolve geapp '{geapp_name}'.")
        sys.exit(1)
    engine_id = engine["name"].split("/")[-1]

    _ensure_apis_and_identities(project_id, project_number)
    _ensure_org_policies(project_id)
    static_ip = _ensure_vpc_nat_psc(cfg)
    _ensure_agent_gateway_and_act(cfg, project_number)
    _ensure_authz_extension_and_policy(cfg)
    mcp_server_resource = _ensure_agent_registry_and_iam_v3(
        cfg, project_number, org_id, engine_id
